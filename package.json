{
  "name": "tajweed-keys",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "مفاتيح التجويد - Tajweed study app (React web + Capacitor Android)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.js",
    "icons": "node scripts/make-icons.mjs",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:android": "npx cap run android",
    "mobile:open": "npx cap open android",
    "mobile:build:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug && cd ..",
    "deploy:web": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.4.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capgo/capacitor-social-login": "^7.20.0",
    "@capgo/capacitor-updater": "^7.53.0",
    "@fontsource/amiri": "^5.2.0",
    "@fontsource/amiri-quran": "^5.2.0",
    "@fontsource/cairo": "^5.2.0",
    "@fontsource/noto-naskh-arabic": "^5.2.0",
    "firebase": "^11.10.0",
    "lucide-react": "^0.548.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "^0.34.0",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.2.0"
  }
}
