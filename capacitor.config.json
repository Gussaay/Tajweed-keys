{
  "appId": "com.tajweed.keys",
  "appName": "مفاتيح التجويد",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#0B5D4F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#094E43"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 15000,
      "responseTimeout": 30,
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    },
    "SocialLogin": {
      "google": true,
      "facebook": false,
      "apple": false,
      "twitter": false
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "force"
  }
}